# Copie ce fichier en .env et remplis les valeurs.
# Le .env réel n'est jamais versionné.

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

RAUVALIA_ENGINE=chromium
# Windows : si le Firefox de Playwright refuse de démarrer, copie-le vers un
# chemin court et pointe-le ici (voir README).
# RAUVALIA_FIREFOX_PATH=C:\ffx\firefox.exe
# RAUVALIA_CHROMIUM_PATH=C:\chromium\chrome.exe

RAUVALIA_PORT=7331

# --- Accès distant (facultatif) ------------------------------------------
# Inutile en local. Requis dès que le serveur sort de la machine.
# RAUVALIA_HOST=0.0.0.0
# RAUVALIA_TOKEN=
# RAUVALIA_CLOUDFLARED=C:\chemin\vers\cloudflared-windows-amd64.exe

# --- Qezaly (tâches envoyées par le back-end) ------------------------------
# Contrat : voir QEZALY.md.
# QEZALY_BACKEND_URL=https://qezaly-backend.fly.dev
# QEZALY_AGENT_TOKEN=          # jeton partagé avec le back-end, dans les deux sens
# QEZALY_MAX_PARALLEL=10       # si le back-end ne répond pas ; sinon maxParallel du back-end
# QEZALY_MAX_STEPS=80
# QEZALY_KEEP_FAILED_MIN=60    # session gardée ouverte après un échec, pour l'admin
# QEZALY_DEFAULT_BIRTHDATE=1995-01-15
# QEZALY_SELF_URL=             # adresse publique (défaut sur Fly : https://<app>.fly.dev)
