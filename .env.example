# Copie ce fichier en .env et remplis les valeurs.
# Le .env réel n'est jamais versionné.

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

RAUVALIA_ENGINE=chromium
# Windows : si le Firefox de Playwright refuse de démarrer, copie-le vers un
# chemin court et pointe-le ici (voir README).
# RAUVALIA_FIREFOX_PATH=C:\ffx\firefox.exe

RAUVALIA_PORT=7331

# --- Accès distant (facultatif) ------------------------------------------
# Inutile en local. Requis dès que le serveur sort de la machine.
# RAUVALIA_HOST=0.0.0.0
# RAUVALIA_TOKEN=
# RAUVALIA_CLOUDFLARED=C:\chemin\vers\cloudflared-windows-amd64.exe
